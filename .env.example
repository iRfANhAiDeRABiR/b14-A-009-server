# Runtime environment
NODE_ENV=development
PORT=5000
JSON_BODY_LIMIT=100kb

# Frontend URL & comma-separated allowed CORS origins (never use * with credentials)
CLIENT_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# MongoDB Atlas / MongoDB Server (required from Commit 02 onward; never commit real credentials)
MONGODB_URI=mongodb_connection_string
DB_NAME=gearnest

# Better Auth & Google OAuth (required for Commit 03+ authentication)
# Generate a strong secret (>= 32 chars): node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:5000
BETTER_AUTH_JWKS_URL=http://localhost:5000/api/auth/jwks
BETTER_AUTH_ISSUER=http://localhost:5000
BETTER_AUTH_AUDIENCE=http://localhost:5000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Stripe Payment Integration (Commit 10 Hosted Checkout / Commit 11 Webhooks)
# Note: Use sk_test_... keys in development; BDT charging depends on connected Stripe account country & eligibility.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=bdt
STRIPE_CHECKOUT_EXPIRE_MINUTES=30

# Temporary booking hold duration in minutes before reservation expiry
BOOKING_HOLD_MINUTES=10

# ImgBB Image Hosting (equipment image uploads)
IMGBB_API_KEY=

# One-time controlled Admin bootstrap script (`npm run seed:admin`) — supply locally/safely, never commit real credentials
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional Automated Booking Completion Cron (runs in UTC)
ENABLE_BOOKING_CRON=true
BOOKING_COMPLETION_CRON=5 0 * * *

# Optional SMTP Email Notifications (skipped cleanly if left unconfigured)
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=
