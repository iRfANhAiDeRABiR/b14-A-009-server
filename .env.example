# Runtime environment
NODE_ENV=development
PORT=5000

# Frontend URL & comma-separated allowed CORS origins (never use * with credentials)
CLIENT_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# MongoDB Atlas / MongoDB Server (planned Commit 02)
MONGODB_URI=
DB_NAME=

# Better Auth & Google OAuth (planned Commit 03)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Stripe Payment Integration (planned Commit 10)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ImgBB Image Hosting (planned equipment image upload milestone)
IMGBB_API_KEY=
