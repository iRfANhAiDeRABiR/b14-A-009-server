{
  "name": "gearnest-server",
  "version": "1.0.0",
  "private": true,
  "description": "GearNest Equipment Rental Platform REST API built with Express.js and JavaScript",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon --watch src src/server.js",
    "start": "node src/server.js",
    "seed:admin": "node src/scripts/seedAdmin.js",
    "seed:equipment": "node --env-file=.env src/scripts/seedDemoEquipment.js",
    "test": "node --test tests/*.test.js",
    "check": "node -e \"const fs=require('fs'),path=require('path'),cp=require('child_process');const walk=d=>fs.existsSync(d)?fs.readdirSync(d,{withFileTypes:true}).flatMap(e=>e.isDirectory()?walk(path.join(d,e.name)):e.name.endsWith('.js')?[path.join(d,e.name)]:[]):[];for(const f of [...walk('src'),...walk('tests')]){const r=cp.spawnSync(process.execPath,['--check',f],{stdio:'inherit'});if(r.status!==0)process.exit(r.status);}\""
  },
  "dependencies": {
    "@better-auth/mongo-adapter": "^1.7.27",
    "better-auth": "^1.7.27",
    "cors": "^2.8.6",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "jose": "^6.2.18",
    "mongodb": "^7.9.1",
    "morgan": "^1.10.0",
    "multer": "^2.5.0",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.6.1",
    "stripe": "^23.2.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.9"
  },
  "engines": {
    "node": ">=18.18.0"
  }
}
