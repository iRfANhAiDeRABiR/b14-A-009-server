# Runtime environment
NODE_ENV=development
PORT=5000

# Frontend URL & comma-separated allowed CORS origins (never use * with credentials)
CLIENT_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# MongoDB Atlas / MongoDB Server (required from Commit 02 onward; never commit real credentials)
MONGODB_URI=mongodb_connection_string
DB_NAME=gearnest

# Better Auth & Google OAuth (required for Commit 03+ authentication)
# Generate a strong secret (>= 32 chars): node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:5000
BETTER_AUTH_JWKS_URL=http://localhost:5000/api/auth/jwks
BETTER_AUTH_ISSUER=http://localhost:5000
BETTER_AUTH_AUDIENCE=http://localhost:5000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Stripe Payment Integration (planned Commit 10)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ImgBB Image Hosting (planned equipment image upload milestone)
IMGBB_API_KEY=
